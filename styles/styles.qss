/* ── Global ── */
QWidget {
    background-color: #0f1117;
    color: #e2e8f0;
    font-family: "Segoe UI", "SF Pro Display", Cantarell, sans-serif;
    font-size: 13px;
}

QLabel {
    background-color: transparent;
}
/* ── Sidebar ── */
#sidebar {
    background-color: #161b27;
    border-right: 1px solid #1e2535;
    min-width: 220px;
    max-width: 220px;
}

#appName {
    font-size: 15px;
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: 0.5px;
}
#appTagline {
    font-size: 11px;
    color: #64748b;
}

#sectionLabel {
    font-size: 10px;
    font-weight: 600;
    color: #475569;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding-left: 4px;
}

/* Nav buttons */
#navBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #94a3b8;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
    padding: 10px 14px;
}
#navBtn:hover {
    background-color: #1e2535;
    color: #e2e8f0;
}
#navBtn[active="true"] {
    background-color: #1d4ed8;
    color: #ffffff;
}
#navBtn[active="true"]:hover {
    background-color: #2563eb;
}

/* Sidebar divider */
#sidebarDivider {
    border: none;
    border-top: 1px solid #1e2535;
}

/* ── Content area ── */
#contentArea {
    background-color: #0f1117;
}

/* ── Page header ── */
#pageIcon {
    font-size: 28px;
    padding-right: 8px;
}
#pageTitle {
    font-size: 20px;
    font-weight: 700;
    color: #f1f5f9;
}
#pageSubtitle {
    font-size: 12px;
    color: #64748b;
}

/* ── Toolbar buttons ── */
#btnPrimary {
    background-color: #1d4ed8;
    color: #ffffff;
    border: none;
    border-radius: 7px;
    padding: 0 18px;
    font-weight: 600;
}
#btnPrimary:hover  { background-color: #2563eb; }
#btnPrimary:pressed { background-color: #1e40af; }

#btnSecondary {
    background-color: #1e2535;
    color: #94a3b8;
    border: 1px solid #2d3748;
    border-radius: 7px;
    padding: 0 14px;
    font-weight: 650;
}
#btnSecondary:hover   { background-color: #263047; color: #e2e8f0; }
#btnSecondary:disabled { color: #374151; border-color: #1e2535; }

#btnDanger {
    background-color: transparent;
    color: #f87171;
    border: 1px solid #3b1f1f;
    border-radius: 7px;
    padding: 0 14px;
    font-weight: 500;
}
#btnDanger:hover    { background-color: #3b1f1f; color: #fca5a5; }
#btnDanger:disabled { color: #374151; border-color: #1e2535; }

#btnNeutral {
    background-color: transparent;
    color: #64748b;
    border: 1px solid #1e2535;
    border-radius: 7px;
    padding: 0 14px;
}
#btnNeutral:hover { background-color: #1e2535; color: #94a3b8; }

/* ── Table ── */
QTableWidget {
    background-color: #161b27;
    alternate-background-color: #1a2030;
    border: 1px solid #1e2535;
    border-radius: 10px;
    gridline-color: transparent;
    selection-background-color: #1d3a6e;
    selection-color: #e2e8f0;
    outline: none;
}
QTableWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #1e2535;
}
QTableWidget::item:selected {
    background-color: #1d3a6e;
    color: #e2e8f0;
}
QHeaderView::section {
    background-color: #1a2030;
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 8px 0px;
    text-align: center;
    border: none;
    border-bottom: 1px solid #1e2535;
}
QScrollBar:vertical {
    background: #161b27;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #2d3748;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

/* ── Status label ── */
#statusLabel {
    font-size: 11px;
    color: #475569;
    padding-top: 2px;
}

/* ── Dialog ── */
QDialog {
    background-color: #161b27;
}
#dialogTitle {
    font-size: 16px;
    font-weight: 700;
    color: #f1f5f9;
}
#divider {
    color: #1e2535;
}
QFormLayout QLabel {
    color: #94a3b8;
    font-size: 12px;
    font-weight: 500;
    min-width: 70px;
}
QLineEdit, QComboBox {
    background-color: #0f1117;
    border: 1px solid #2d3748;
    border-radius: 6px;
    color: #e2e8f0;
    padding: 7px 10px;
    selection-background-color: #1d4ed8;
}
QLineEdit:focus, QComboBox:focus {
    border-color: #1d4ed8;
}
QLineEdit::placeholder { color: #374151; }
QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #1a2030;
    border: 1px solid #2d3748;
    selection-background-color: #1d4ed8;
    color: #e2e8f0;
}

/* ── Dialog button box ── */
QDialogButtonBox QPushButton {
    border-radius: 6px;
    padding: 7px 20px;
    font-weight: 600;
    min-width: 80px;
}
QDialogButtonBox QPushButton[text="Save"] {
    background-color: #1d4ed8;
    color: #ffffff;
    border: none;
}
QDialogButtonBox QPushButton[text="Save"]:hover { background-color: #2563eb; }
QDialogButtonBox QPushButton[text="Cancel"] {
    background-color: #1e2535;
    color: #94a3b8;
    border: 1px solid #2d3748;
}
QDialogButtonBox QPushButton[text="Cancel"]:hover { background-color: #263047; }

/* ── Message box ── */
QMessageBox {
    background-color: #161b27;
}
QMessageBox QLabel { color: #e2e8f0; }
QMessageBox QPushButton {
    background-color: #1e2535;
    color: #e2e8f0;
    border: 1px solid #2d3748;
    border-radius: 6px;
    padding: 6px 18px;
    min-width: 70px;
}
QMessageBox QPushButton:hover   { background-color: #263047; }
QMessageBox QPushButton[text="&Yes"],
QMessageBox QPushButton[text="Yes"] {
    background-color: #7f1d1d;
    color: #fca5a5;
    border-color: #991b1b;
}
QMessageBox QPushButton[text="&Yes"]:hover,
QMessageBox QPushButton[text="Yes"]:hover { background-color: #991b1b; }

/* ═══════════════════════════════════════════════════════════════════════ */
/* PHASE 5 — Subscription Page                                          */
/* ═══════════════════════════════════════════════════════════════════════ */

/* ── Panel title ── */
#panelTitle {
    font-size: 14px;
    font-weight: 700;
    color: #f1f5f9;
    padding-bottom: 2px;
}

/* ── Nhãn phần trong form đăng ký ── */
#formSectionLabel {
    font-size: 11px;
    font-weight: 600;
    color: #475569;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding-top: 4px;
}

/* ── Preview Card ── */
#previewCard {
    background-color: #161b27;
    border: 1px solid #1e2535;
    border-radius: 10px;
    padding: 4px;
}

#previewTitle {
    font-size: 12px;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}

#previewKey {
    font-size: 12px;
    color: #64748b;
    font-weight: 500;
}

#previewValue {
    font-size: 13px;
    font-weight: 700;
    color: #e2e8f0;
}

/* ── Empty state ── */
#emptyStateLabel {
    font-size: 13px;
    color: #475569;
    line-height: 1.8;
}

/* ── QSplitter handle ── */
QSplitter::handle {
    background-color: #1e2535;
    width: 1px;
}
QSplitter::handle:hover {
    background-color: #2d3748;
}

/* ═══════════════════════════════════════════════════════════════════════ */
/* PHASE 8 — Dashboard                                                   */
/* ═══════════════════════════════════════════════════════════════════════ */

#statCard {
    background-color: #161b27;
    border: 1px solid #1e2535;
    border-radius: 10px;
}

#statCardIcon {
    font-size: 16px;
}

#statCardLabel {
    font-size: 9px;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 0px;
    text-transform: uppercase;
}

#statCardValue {
    font-size: 20px;
    font-weight: 700;
    padding-top: 2px;
}

#sectionTitle {
    font-size: 13px;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.4px;
    padding-bottom: 2px;
}

/* ═══════════════════════════════════════════════════════════════════════ */
/* LOGIN WINDOW                                                         */
/* ═══════════════════════════════════════════════════════════════════════ */

#loginWindow {
    background-color: #1a1d23;
}

#loginHeader {
    background-color: transparent;
}

#loginTitle {
    color: #ffffff;
    font-size: 26px;
    font-weight: bold;
    font-family: 'Segoe UI';
}

#loginSubtitle {
    color: #8b95a5;
    font-size: 12px;
    font-family: 'Segoe UI';
}

#loginCard {
    background-color: #23262e;
    border: 1px solid #2f3545;
    border-radius: 12px;
    min-width: 320px;
    max-width: 320px;
}

#loginTitle, #loginSubtitle, #loginLabel, #loginFooter {
    background: transparent;
}

#loginLabel {
    color: #c5cdd8;
    font-size: 13px;
    font-family: 'Segoe UI';
    font-weight: 600;
}

/* Ô nhập Tên đăng nhập bình thường */
#loginInput {
    background-color: #2c3040;
    color: #e8edf2;
    border: 1.5px solid #3a3f52;
    border-radius: 7px;
    padding: 0 12px;
    font-size: 13px;
    font-family: 'Segoe UI';
}

#loginInput:focus {
    border-color: #5b8dee;
    background-color: #2f3447;
}

/* =========================================================
   GIAO DIỆN MẬT KHẨU LIỀN KHỐI (VIỀN BAO TRỌN CẢ KHUNG)
========================================================= */

/* 1. Container đóng vai trò như một ô input thực thụ */
#passContainer {
    background-color: #2c3040;
    border: 1.5px solid #3a3f52;
    border-radius: 7px;
}

/* 2. Đổi màu viền và nền toàn bộ khối khi ô input bên trong được focus */
#passContainer[focused="true"] {
    border-color: #5b8dee;
    background-color: #2f3447;
}

/* 3. Ô nhập Mật Khẩu (Xóa viền và nền để hòa vào container) */
#passwordInput {
    background-color: transparent;
    color: #e8edf2;
    border: none;
    padding: 0 12px;
    font-size: 13px;
    font-family: 'Segoe UI';
}

#passwordInput:focus {
    background-color: transparent;
    border: none;
}

/* 4. Nút con mắt (Xóa viền và nền để hòa vào container) */
#togglePassBtn {
    background-color: transparent;
    color: #8b95a5;
    border: none;
    font-size: 16px;
}

#togglePassBtn:hover {
    color: #ffffff; /* Biểu tượng con mắt sáng lên khi rê chuột vào */
}

#togglePassBtn:checked {
    color: #5b8dee;
}
/* ========================================================= */

#loginBtn {
    background-color: #5b8dee;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    font-family: 'Segoe UI';
}

#loginBtn:hover {
    background-color: #4a7de0;
}

#loginBtn:pressed {
    background-color: #3a6dd0;
}

#loginFooter {
    color: #4a5060;
    font-size: 11px;
    font-family: 'Segoe UI';
    padding: 10px;
}

/* ═══════════════════════════════════════════════════════════════════════ */
/* PHASE 10 — QR Check-in Page                                          */
/* ═══════════════════════════════════════════════════════════════════════ */

#missingDepsCmd {
    font-family: Consolas, monospace;
    font-size: 13px;
    background-color: #1e293b;
    color: #38bdf8;
    padding: 10px 20px;
    border-radius: 6px;
}

#statusIcon {
    font-size: 28px;
}

QFrame#statusCard {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 12px 16px;
}

#camViewLabel {
    background-color: #0f172a;
    border: 2px solid #334155;
    border-radius: 8px;
    color: #64748b;
    font-size: 14px;
}

#memberImgLabel {
    background-color: #1e293b;
    border: 2px solid #334155;
    border-radius: 8px;
    color: #64748b;
}

#memberTitleLabel {
    color: #ffffff;
    font-weight: bold;
    font-size: 14px;
    background-color: rgba(0, 0, 0, 150);
    padding: 6px 16px;
    border-radius: 6px;
}

#memberNameLabel {
    color: #38bdf8;
    font-weight: bold;
    font-size: 20px;
    background-color: rgba(0, 0, 0, 150);
    padding: 8px 16px;
    border-radius: 6px;
}

#statusResultLabel {
    font-weight: 600;
    font-size: 14px;
}
#statusResultLabel[status="valid"] { color: #22c55e; }
#statusResultLabel[status="expired"] { color: #f59e0b; }
#statusResultLabel[status="no_subscription"] { color: #ef4444; }
#statusResultLabel[status="error"] { color: #ef4444; }
#statusResultLabel[status="default"] { color: #94a3b8; }